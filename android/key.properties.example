# Copy to android/key.properties (ignored by git) and fill in the release keystore.
# Generate a keystore:
#   keytool -genkey -v -keystore ~/lineduty-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias lineduty
storeFile=/Users/<you>/lineduty-release.jks
storePassword=CHANGE_ME
keyAlias=lineduty
keyPassword=CHANGE_ME
